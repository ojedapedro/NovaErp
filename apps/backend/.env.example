# NovaERP Backend — Variables de Entorno

# ─────────────────────────────────────────
# Aplicación
# ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────
# Base de Datos (PostgreSQL)
# ─────────────────────────────────────────
# Local (Docker Compose):
DATABASE_URL=postgresql://nova_admin:nova_secure_password@localhost:5433/nova_erp?schema=public

# Producción (DigitalOcean Managed PostgreSQL):
# DATABASE_URL=postgresql://user:pass@db-postgresql-nyc1-xxxxx.ondigitalocean.com:25060/nova_erp?schema=public&sslmode=require

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
# Local:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Producción (DigitalOcean Managed Redis):
# REDIS_HOST=db-redis-nyc1-xxxxx.ondigitalocean.com
# REDIS_PORT=25061
# REDIS_PASSWORD=xxxxx

# ─────────────────────────────────────────
# MinIO / Object Storage (S3-compatible)
# ─────────────────────────────────────────
# Local (Docker Compose MinIO):
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_secure_password
STORAGE_BUCKET=nova-erp-fiscal-docs

# Producción (DigitalOcean Spaces):
# STORAGE_ENDPOINT=nyc3.digitaloceanspaces.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_ACCESS_KEY=xxxxx
# STORAGE_SECRET_KEY=xxxxx
# STORAGE_BUCKET=nova-erp-fiscal-docs

# ─────────────────────────────────────────
# JWT / Autenticación
# ─────────────────────────────────────────
# ⚠️ CAMBIAR estos valores en producción por secretos fuertes y únicos
JWT_ACCESS_SECRET=super_secure_access_jwt_secret_key_2026_CAMBIAR_EN_PRODUCCION
JWT_REFRESH_SECRET=super_secure_refresh_jwt_secret_key_2026_CAMBIAR_EN_PRODUCCION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
